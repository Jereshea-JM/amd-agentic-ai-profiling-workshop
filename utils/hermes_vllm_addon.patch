@@ -0,0 +1,532 @@
+"""Internal-only: MLflow run tracking + vLLM prefix-cache hit-rate metrics.
+
+Layers on top of csv_dump.py (must be applied first — the addon patch this
+ships as depends on it). Writes vllm_cache_metrics.csv into the same shared
+per-process output directory csv_dump.py already creates, and mirrors the
+same per-turn numbers into MLflow as step-indexed metrics.
+
+Adapted from the original (session-scoped) design for the current per-process
+architecture: turn numbers come from tracer.sessions.turn_number(session_id)
+instead of the old tool_profiler.current_turn(), and CSV/artifact output goes
+to csv_dump's shared run directory instead of a per-session directory.
+
+Off by default. Opt-in via HERMES_VLLM_CACHE_METRICS=true. Needs ``mlflow``
+and ``requests`` importable; degrades to a no-op (logged once) if either is
+missing or the MLflow tracking server is unreachable.
+"""
+
+from __future__ import annotations
+
+import csv
+import functools
+import logging
+import os
+from datetime import datetime
+from typing import Any, Dict, Optional
+
+from .debug_utils import debug_log, logger
+
+try:
+    import mlflow
+
+    MLFLOW_AVAILABLE = True
+except ImportError:
+    MLFLOW_AVAILABLE = False
+
+try:
+    import requests
+
+    REQUESTS_AVAILABLE = True
+except ImportError:
+    REQUESTS_AVAILABLE = False
+
+
+_TRUE = ("1", "true", "yes", "on")
+
+
+def _flag(name: str) -> bool:
+    return os.environ.get(name, "").strip().lower() in _TRUE
+
+
+def vllm_cache_metrics() -> bool:
+    return _flag("HERMES_VLLM_CACHE_METRICS")
+
+
+def vllm_port() -> str:
+    return os.environ.get("HERMES_VLLM_PORT") or os.environ.get("VLLM_HERMES_PORT") or "8001"
+
+
+def mlflow_enabled() -> bool:
+    return vllm_cache_metrics()
+
+
+# MLflow applies these settings when a run starts, so defining them here —
+# after the imports — still takes effect before the first run. Disabling
+# system-metrics logging matters: it stops MLflow from launching its own
+# background sampler thread, keeping all hardware sampling in host_metrics.py.
+os.environ["MLFLOW_ENABLE_SYSTEM_METRICS_LOGGING"] = "false"
+os.environ["MLFLOW_SYSTEM_METRICS_SAMPLING_INTERVAL"] = "1"
+os.environ["MLFLOW_TRACKING_URI"] = os.environ.get("MLFLOW_TRACKING_URI", "http://127.0.0.1:5000")
+os.environ["MLFLOW_LOGGING_LEVEL"] = os.environ.get("MLFLOW_LOGGING_LEVEL", "ERROR")
+
+
+def _mute_mlflow_logging():
+    """Silence MLflow's own INFO logs (e.g. "View run"/"View experiment" URLs).
+    MLflow lazily (re)configures its loggers to INFO on API calls, so this must
+    be invoked right before each start_run/end_run, not once at import time."""
+    for name in ("mlflow", "mlflow.tracking.fluent"):
+        logging.getLogger(name).setLevel(logging.WARNING)
+
+
+def _log_run_url(tracking_uri: str, run) -> None:
+    """Print the run's URL through the plugin's own logger, once per attach.
+
+    MLflow's own "View run" message is muted above because whether it is
+    emitted through logging (and therefore actually muted) or printed directly
+    varies by version, making it an unreliable way to surface the link. Using
+    the plugin's "hermes_otel" logger instead is deterministic: it always has
+    a stderr handler at INFO level, independent of MLflow's own logging
+    configuration."""
+    base = tracking_uri.rstrip("/")
+    url = f"{base}/#/experiments/{run.info.experiment_id}/runs/{run.info.run_id}"
+    logger.info("[hermes-otel] MLflow run: %s", url)
+
+
+def _current_out_dir() -> str:
+    """The shared per-process output directory csv_dump.py already creates —
+    vllm_cache_metrics.csv and MLflow artifact uploads live alongside the
+    CPU/GPU/tool CSVs from that same run."""
+    from . import csv_dump
+
+    return csv_dump._ensure_output_dir()
+
+
+def _current_turn(session_id: str) -> int:
+    try:
+        from .tracer import get_tracer
+
+        return get_tracer().sessions.turn_number(session_id) or 0
+    except Exception:
+        return 0
+
+
+# Track active MLflow run per session
+_active_runs: Dict[str, str] = {}
+# Track vLLM cache baseline metrics per session
+_cache_baselines: Dict[str, Dict[str, float]] = {}
+# Track turn number per session for step-based metrics
+_turn_counters: Dict[str, int] = {}
+# Per session: True when the next on_pre_llm_call should capture a fresh
+# baseline (i.e. a new user turn has begun). Prevents intra-turn LLM calls
+# from re-snapping the baseline and producing ~0 deltas.
+_awaiting_baseline: Dict[str, bool] = {}
+# session_id -> highest turn number already logged to MLflow. on_session_end
+# can fire more than once for the same turn (e.g. a normal completion followed
+# by an interrupt/exit). Without this guard the second call logs the same
+# step again, plotting two points at one step. We log a turn at most once.
+_last_logged_turn: Dict[str, int] = {}
+# Ensure the process-exit handler that closes runs is registered exactly once
+_atexit_registered = False
+# Set once MLflow has failed to start a run (e.g. an unreachable or
+# misconfigured tracking server). Further MLflow work is then skipped for the
+# rest of the process so the failure is reported once, not on every turn.
+_mlflow_disabled = False
+_installed = False
+
+
+def has_active_run(session_id: str) -> bool:
+    return session_id in _active_runs
+
+
+def capture_turn_baseline(session_id: str) -> None:
+    """Snapshot vLLM cache counters at the START of a user turn.
+
+    Captured only once per turn (first LLM call after the previous turn
+    ended), guarded by the _awaiting_baseline flag, so intra-turn LLM calls
+    don't re-snap it and produce a ~0 delta."""
+    if not MLFLOW_AVAILABLE or not session_id or not vllm_cache_metrics():
+        return
+    if session_id not in _active_runs:
+        return
+    if not _awaiting_baseline.get(session_id, False):
+        return
+    _cache_baselines[session_id] = scrape_vllm_cache_metrics(vllm_port())
+    _awaiting_baseline[session_id] = False
+
+
+def scrape_vllm_cache_metrics(port: str = "8001") -> Dict[str, float]:
+    """Scrape vLLM's Prometheus endpoint to extract raw cache counter values."""
+    metrics = {"prefix_hits": 0.0, "prefix_queries": 0.0, "mm_hits": 0.0, "mm_queries": 0.0}
+    if not REQUESTS_AVAILABLE:
+        return metrics
+    try:
+        res = requests.get(f"http://localhost:{port}/metrics", timeout=2)
+        if res.status_code == 200:
+            for line in res.text.splitlines():
+                if line.startswith("vllm:prefix_cache_hits_total"):
+                    metrics["prefix_hits"] = float(line.split()[-1])
+                elif line.startswith("vllm:prefix_cache_queries_total"):
+                    metrics["prefix_queries"] = float(line.split()[-1])
+                elif line.startswith("vllm:mm_cache_hits_total"):
+                    metrics["mm_hits"] = float(line.split()[-1])
+                elif line.startswith("vllm:mm_cache_queries_total"):
+                    metrics["mm_queries"] = float(line.split()[-1])
+    except Exception:
+        pass
+    return metrics
+
+
+def _find_existing_run(session_id: str) -> Optional[str]:
+    try:
+        experiment = mlflow.get_experiment_by_name(
+            os.environ.get("MLFLOW_EXPERIMENT_NAME", "Default")
+        )
+        if not experiment:
+            return None
+        client = mlflow.tracking.MlflowClient()
+        runs = client.search_runs(
+            experiment_ids=[experiment.experiment_id],
+            filter_string=f"params.session_id = '{session_id}'",
+            max_results=1,
+            order_by=["start_time DESC"],
+        )
+        return runs[0].info.run_id if runs else None
+    except Exception:
+        return None
+
+
+def start_mlflow_run(session_id: str, model: str, platform: str, **kwargs):
+    global _mlflow_disabled
+    if not MLFLOW_AVAILABLE or not mlflow_enabled() or _mlflow_disabled:
+        return
+
+    _mute_mlflow_logging()
+    tracking_uri = os.environ.get("MLFLOW_TRACKING_URI", "http://127.0.0.1:5000")
+
+    try:
+        mlflow.set_tracking_uri(tracking_uri)
+        mlflow.set_experiment(os.environ.get("MLFLOW_EXPERIMENT_NAME", "Default"))
+
+        existing_run_id = _find_existing_run(session_id)
+        if existing_run_id:
+            run = mlflow.start_run(run_id=existing_run_id)
+            _active_runs[session_id] = run.info.run_id
+            _log_run_url(tracking_uri, run)
+            _turn_counters[session_id] = _current_turn(session_id) or 1
+            if vllm_cache_metrics():
+                _cache_baselines[session_id] = scrape_vllm_cache_metrics(vllm_port())
+                _awaiting_baseline[session_id] = True
+            _register_atexit_once()
+            return
+
+        custom_name = os.environ.get("MLFLOW_RUN_NAME", "")
+        clean_model = model.replace("/", "_").replace(":", "_")
+        if custom_name:
+            run_name = custom_name.format(
+                platform=platform, model=model, clean_model=clean_model, session_id=session_id
+            )
+        else:
+            run_name = f"Hermes_{clean_model}_{session_id}"
+
+        run = mlflow.start_run(run_name=run_name)
+        _active_runs[session_id] = run.info.run_id
+        _log_run_url(tracking_uri, run)
+
+        mlflow.log_param("session_id", session_id)
+        mlflow.log_param("model", model)
+        mlflow.log_param("platform", platform)
+
+        if vllm_cache_metrics():
+            _cache_baselines[session_id] = scrape_vllm_cache_metrics(vllm_port())
+            _awaiting_baseline[session_id] = True
+
+        _turn_counters[session_id] = 1
+        _register_atexit_once()
+
+    except Exception as e:
+        import traceback
+
+        _mlflow_disabled = True
+        logger.warning(
+            "[hermes-otel] MLflow run could not be started (%s); disabling MLflow "
+            "metrics for the rest of this process. Check MLFLOW_TRACKING_URI.",
+            e,
+        )
+        debug_log(f"MLflow start_run traceback:\n{traceback.format_exc()}")
+
+
+def _register_atexit_once():
+    global _atexit_registered
+    if _atexit_registered:
+        return
+    import atexit
+
+    atexit.register(_end_all_runs_at_exit)
+    _atexit_registered = True
+
+
+def _upload_profiling_artifacts(run_id: str, session_id: str, include_plots: bool = False) -> None:
+    """Upload the shared run's CPU/GPU/tool/vLLM CSVs, overwriting prior
+    versions. Called every turn so a crash or kill -9 never loses them.
+
+    include_plots=True (only at final exit, from _end_all_runs_at_exit) also
+    renders and uploads the PNG charts. Rendering happens via
+    csv_dump.render_plots() rather than assuming csv_dump's own atexit
+    handler already ran — atexit fires LIFO, and csv_dump.install() (called
+    first, at plugin init) registers its plot-rendering handler before this
+    module's _end_all_runs_at_exit gets registered (at first session start),
+    so without this the PNGs would not exist yet when this runs. Also skips
+    plot rendering entirely on every non-final call, so it never fires
+    mid-session."""
+    if not MLFLOW_AVAILABLE or not run_id:
+        return
+    try:
+        client = mlflow.tracking.MlflowClient()
+        out_dir = _current_out_dir()
+        for fname in (
+            "cpu_hermes_trace.csv",
+            "cpu_system_wide.csv",
+            "gpu_system_wide.csv",
+            "tool_execution.csv",
+            "vllm_cache_metrics.csv",
+        ):
+            fpath = os.path.join(out_dir, fname)
+            if os.path.exists(fpath):
+                try:
+                    client.log_artifact(run_id, fpath, artifact_path="profiling")
+                except Exception:
+                    pass
+
+        if include_plots:
+            from . import csv_dump
+
+            csv_dump.render_plots()
+            plots_dir = os.path.join(out_dir, "plots")
+            if os.path.isdir(plots_dir):
+                for fname in sorted(os.listdir(plots_dir)):
+                    if not fname.endswith(".png"):
+                        continue
+                    fpath = os.path.join(plots_dir, fname)
+                    try:
+                        client.log_artifact(run_id, fpath, artifact_path="profiling/plots")
+                    except Exception:
+                        pass
+    except Exception:
+        pass
+
+
+def _end_all_runs_at_exit():
+    if not MLFLOW_AVAILABLE:
+        return
+    keep_run_active = os.environ.get("MLFLOW_KEEP_RUN_ACTIVE", "false").lower() == "true"
+    client = mlflow.tracking.MlflowClient()
+    for session_id, run_id in list(_active_runs.items()):
+        try:
+            _upload_profiling_artifacts(run_id, session_id, include_plots=True)
+            if not keep_run_active:
+                client.set_terminated(run_id, status="FINISHED")
+        except Exception:
+            pass
+        finally:
+            _active_runs.pop(session_id, None)
+            _cache_baselines.pop(session_id, None)
+            _turn_counters.pop(session_id, None)
+            _awaiting_baseline.pop(session_id, None)
+            _last_logged_turn.pop(session_id, None)
+
+
+_VLLM_CACHE_HEADER = [
+    "turn",
+    "timestamp",
+    "start_time_unix_nano",
+    "text_hits",
+    "text_queries",
+    "text_hit_rate_pct",
+    "mm_hits",
+    "mm_queries",
+    "mm_hit_rate_pct",
+]
+
+
+def _append_vllm_cache_csv(
+    turn, text_hits, text_queries, text_hit_rate, mm_hits, mm_queries, mm_hit_rate
+):
+    """Append one per-turn row to <out_dir>/vllm_cache_metrics.csv (created
+    with a header on first write) — the CSV twin of the MLflow cache graphs,
+    so the same numbers are available offline / uploaded as an artifact."""
+    try:
+        out_dir = _current_out_dir()
+        path = os.path.join(out_dir, "vllm_cache_metrics.csv")
+        is_new = not os.path.exists(path) or os.path.getsize(path) == 0
+        wall = datetime.now()
+        ts = wall.strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
+        ts_ns = int(wall.timestamp() * 1_000_000_000)
+        with open(path, "a", newline="") as f:
+            w = csv.writer(f)
+            if is_new:
+                w.writerow(_VLLM_CACHE_HEADER)
+            w.writerow(
+                [
+                    turn,
+                    ts,
+                    ts_ns,
+                    int(text_hits),
+                    int(text_queries),
+                    round(text_hit_rate, 2),
+                    int(mm_hits),
+                    int(mm_queries),
+                    round(mm_hit_rate, 2),
+                ]
+            )
+    except Exception as e:
+        debug_log(f"could not append vllm_cache_metrics.csv: {e}")
+
+
+def end_mlflow_run(
+    session_id: str, completed: bool, interrupted: bool, model: str, platform: str, **kwargs
+):
+    if not MLFLOW_AVAILABLE:
+        return
+    _mute_mlflow_logging()
+
+    run_id = _active_runs.get(session_id)
+    if not run_id:
+        return
+
+    try:
+        baseline = _cache_baselines.get(session_id, None)
+        if baseline:
+            after_metrics = scrape_vllm_cache_metrics(vllm_port())
+
+            req_text_queries = after_metrics["prefix_queries"] - baseline["prefix_queries"]
+            req_text_hits = after_metrics["prefix_hits"] - baseline["prefix_hits"]
+            req_mm_queries = after_metrics["mm_queries"] - baseline["mm_queries"]
+            req_mm_hits = after_metrics["mm_hits"] - baseline["mm_hits"]
+
+            text_hit_rate = (
+                (req_text_hits / req_text_queries * 100) if req_text_queries > 0 else 0.0
+            )
+            mm_hit_rate = (req_mm_hits / req_mm_queries * 100) if req_mm_queries > 0 else 0.0
+
+            turn_number = _current_turn(session_id) or _turn_counters.get(session_id, 1)
+
+            already_logged = _last_logged_turn.get(session_id) == turn_number
+            if not already_logged:
+                _last_logged_turn[session_id] = turn_number
+
+                client = mlflow.tracking.MlflowClient()
+                client.log_metric(
+                    run_id, "vllm_text_cache_hit_rate_pct", text_hit_rate, step=turn_number
+                )
+                client.log_metric(run_id, "vllm_text_cache_hits", req_text_hits, step=turn_number)
+                client.log_metric(
+                    run_id, "vllm_text_cache_queries", req_text_queries, step=turn_number
+                )
+                client.log_metric(
+                    run_id, "vllm_mm_cache_hit_rate_pct", mm_hit_rate, step=turn_number
+                )
+                client.log_metric(run_id, "vllm_mm_cache_hits", req_mm_hits, step=turn_number)
+                client.log_metric(run_id, "vllm_mm_cache_queries", req_mm_queries, step=turn_number)
+
+                if req_text_queries > 0 or req_mm_queries > 0:
+                    client.set_tag(run_id, "cache.text_hit_tokens", int(req_text_hits))
+                    client.set_tag(run_id, "cache.text_hit_rate", f"{text_hit_rate:.1f}%")
+                    client.set_tag(
+                        run_id, "cache.image_hit", "True" if req_mm_hits > 0 else "False"
+                    )
+                    client.set_tag(run_id, "latest_turn", turn_number)
+
+                _append_vllm_cache_csv(
+                    turn_number,
+                    req_text_hits,
+                    req_text_queries,
+                    text_hit_rate,
+                    req_mm_hits,
+                    req_mm_queries,
+                    mm_hit_rate,
+                )
+
+            _turn_counters[session_id] = turn_number
+            _awaiting_baseline[session_id] = True
+
+        status = "FINISHED" if completed else "FAILED" if interrupted else "KILLED"
+        client = mlflow.tracking.MlflowClient()
+        client.set_tag(run_id, "status", status)
+        client.set_tag(run_id, "completed", str(completed))
+        client.set_tag(run_id, "interrupted", str(interrupted))
+
+        _upload_profiling_artifacts(run_id, session_id)
+
+    except Exception as e:
+        import traceback
+
+        logger.warning("[hermes-otel] MLflow: failed to end run: %s", e)
+        debug_log(f"MLflow end_run traceback:\n{traceback.format_exc()}")
+
+
+# --------------------------------------------------------------------------- #
+# Hook wiring — wraps hooks.py functions by name, same pattern as csv_dump.py.
+# --------------------------------------------------------------------------- #
+def _wrap_by_name(module: Any, name: str, wrapper_factory) -> None:
+    original = getattr(module, name, None)
+    if not callable(original):
+        debug_log(f"mlflow_hooks: {name} not found on {module.__name__}; skipping wrap")
+        return
+    if getattr(original, "_hermes_mlflow_wrapped", False):
+        return
+    wrapped = wrapper_factory(original)
+    wrapped._hermes_mlflow_wrapped = True
+    setattr(module, name, wrapped)
+
+
+def _wrap_session_start(original):
+    @functools.wraps(original)
+    def wrapper(session_id, model, platform, **kwargs):
+        if mlflow_enabled():
+            try:
+                start_mlflow_run(session_id, model, platform, **kwargs)
+            except Exception as e:
+                debug_log(f"mlflow_hooks: start_mlflow_run failed: {e}")
+        return original(session_id, model, platform, **kwargs)
+
+    return wrapper
+
+
+def _wrap_pre_llm_call(original):
+    @functools.wraps(original)
+    def wrapper(session_id, *args, **kwargs):
+        if vllm_cache_metrics():
+            try:
+                capture_turn_baseline(session_id)
+            except Exception as e:
+                debug_log(f"mlflow_hooks: capture_turn_baseline failed: {e}")
+        return original(session_id, *args, **kwargs)
+
+    return wrapper
+
+
+def _wrap_session_end(original):
+    @functools.wraps(original)
+    def wrapper(session_id, completed, interrupted, model, platform, **kwargs):
+        result = original(session_id, completed, interrupted, model, platform, **kwargs)
+        if mlflow_enabled():
+            try:
+                end_mlflow_run(session_id, completed, interrupted, model, platform, **kwargs)
+            except Exception as e:
+                debug_log(f"mlflow_hooks: end_mlflow_run failed: {e}")
+        return result
+
+    return wrapper
+
+
+def install() -> None:
+    global _installed
+    if _installed:
+        return
+    _installed = True
+
+    from . import hooks
+
+    _wrap_by_name(hooks, "on_session_start", _wrap_session_start)
+    _wrap_by_name(hooks, "on_pre_llm_call", _wrap_pre_llm_call)
+    _wrap_by_name(hooks, "on_session_end", _wrap_session_end)
