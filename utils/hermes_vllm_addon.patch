+def _plot_vllm(rows, out_dir):
+    """Two stacked charts, both x = turn: text cache hit rate, then multimodal
+    cache hit rate. Each y-axis is fixed to 0-100 % so turns stay comparable."""
+    if not rows:
+        return
+    turns = [_f(r.get("turn")) for r in rows]
+    text_rate = [_f(r.get("text_hit_rate_pct")) for r in rows]
+    mm_rate = [_f(r.get("mm_hit_rate_pct")) for r in rows]
