diff --git a/metrics_poller.py b/metrics_poller.py
new file mode 100644
index 0000000..f4535e0
--- /dev/null
+++ b/metrics_poller.py
@@ -0,0 +1,337 @@
+"""Standalone CPU / GPU metrics poller (runs as a separate OS process).
+
+Launched by tool_profiler via subprocess.Popen so that all sampling happens
+OUTSIDE the hermes interpreter (no extra threads inside hermes). It samples on a
+fixed interval and appends timestamped rows to one CSV per ENABLED signal:
+
+  * cpu_hermes_trace.csv  — hermes process + children CPU%%   [HERMES_CPU_TRACE]
+  * cpu_system_wide.csv   — whole-host CPU%%                  [HERMES_CPU_SYSTEM_WIDE]
+  * gpu_system_wide.csv   — gfx_busy / power / vram (AMD)     [HERMES_GPU_SYSTEM_WIDE]
+
+Which files are written is decided entirely by the HERMES_* env flags, which the
+subprocess inherits from the launching hermes process (see profiling_env.py for
+the authoritative list). Disabled signals are never scraped. cpu_hermes_trace is
+attributable to hermes; the system-wide CPU includes the OS, other containers and
+vLLM and is provided as context only.
+
+Usage:
+    python metrics_poller.py <out_dir> <exporter_url> <interval> <hermes_pid>
+
+Runs until SIGTERM/SIGINT, flushing each row so the CSVs can be read while still
+being written. Imports nothing from the hermes plugin.
+"""
+
+import os
+import csv
+import sys
+import time
+import signal
+from datetime import datetime
+
+try:
+    import requests
+except ImportError:
+    requests = None
+
+try:
+    import psutil
+except ImportError:
+    psutil = None
+
+
+def _flag(name: str) -> bool:
+    """Standalone copy of profiling_env._flag (this process can't import the
+    plugin). The variable NAMES are the contract shared with profiling_env.py."""
+    return os.environ.get(name, "").strip().lower() in ("1", "true", "yes", "on")
+
+
+_RUNNING = True
+
+
+def _stop(signum, frame):
+    global _RUNNING
+    _RUNNING = False
+
+
+def _parse_metric_value(line: str) -> float:
+    """Return the float value of a Prometheus sample line ('name{labels} value')."""
+    return float(line.split()[-1])
+
+
+def scrape_gpu(url: str):
+    """Fetch one snapshot of (gfx_busy, power, vram) from the exporter."""
+    gfx = power = vram = 0.0
+    if requests is None:
+        return gfx, power, vram
+    try:
+        resp = requests.get(url, timeout=0.2)
+        if resp.status_code != 200:
+            return gfx, power, vram
+        for line in resp.text.splitlines():
+            if line.startswith("gpu_gfx_busy_instantaneous{") and 'xcc_index="0"' in line:
+                gfx = _parse_metric_value(line)
+            elif line.startswith("gpu_power_usage{"):
+                power = _parse_metric_value(line)
+            elif line.startswith("gpu_used_vram{"):
+                vram = _parse_metric_value(line)
+    except Exception:
+        pass
+    return gfx, power, vram
+
+
+def _cpu_seconds(proc) -> float:
+    """Return the cumulative CPU seconds (user + system) consumed by a process.
+
+    Reaped-child time (``children_user`` / ``children_system``) is intentionally
+    excluded: those counters credit a child's entire lifetime to the parent at
+    reap time, dumping it into a single sample window and producing spurious
+    spikes. Live descendants are instead measured directly, tick by tick.
+    """
+    t = proc.cpu_times()
+    return t.user + t.system
+
+
+def sample_cpu(state: dict, root, contributors=None):
+    """Return the machine-wide CPU% of ``root`` plus its live descendants.
+
+    The value is normalized against total machine capacity, so 100% means every
+    logical core is fully utilized by the measured process tree and a single
+    fully-busy core reads as ``100 / ncpu`` percent. This keeps CPU on the same
+    0..100 scale as GPU busy%, so the two signals are directly comparable.
+
+    Utilization is computed the same way ``top``, ``htop`` and ``psutil`` do it:
+    the OS exposes only a cumulative per-process CPU-time counter, so the CPU
+    time spent during a tick is obtained by differencing that counter between
+    two samples and dividing by the elapsed wall-clock time. The elapsed time is
+    measured, not assumed from the poll interval, because the true spacing
+    between samples includes scrape, write and scheduling latency and therefore
+    drifts above the nominal interval. Dividing the summed CPU-time delta by
+    ``ncpu * elapsed`` yields a fraction bounded to 0..100.
+
+    Both the wall clock and every process counter are read once per tick, in a
+    single pass captured immediately after the timestamp, and the same snapshot
+    is carried over as the next tick's baseline. Reading the timestamp and all
+    counters at one consistent point keeps the CPU-time window and the elapsed
+    window aligned across every process, so the result does not creep above 100.
+
+    Args:
+        state: Cross-tick cache holding ``"prev"`` (a ``pid -> cpu_seconds``
+            snapshot from the previous tick) and ``"wall"`` (its timestamp).
+            The first call only records the baseline and returns ``0.0``.
+        root: The root ``psutil.Process`` (the hermes process).
+        contributors: Optional list; when provided, receives a
+            ``(pid, cpu_pct, name, cmdline)`` tuple for each process that
+            consumed CPU during the interval (used by the debug mode).
+
+    Returns:
+        CPU utilization as a percentage in the range 0..100, or ``0.0`` when
+        psutil is unavailable, the root has exited, or on the priming call.
+    """
+    if psutil is None or root is None:
+        return 0.0
+
+    # Enumerate the process tree. The poller runs as a child of hermes (spawned
+    # via Popen) and therefore appears in children(recursive=True); exclude its
+    # own PID so the poller's sampling overhead is not attributed to hermes.
+    self_pid = os.getpid()
+    try:
+        current = {root.pid: root}
+        for child in root.children(recursive=True):
+            if child.pid == self_pid:
+                continue
+            current[child.pid] = child
+    except psutil.NoSuchProcess:
+        return 0.0
+
+    # Take a single snapshot per tick: the wall clock followed immediately by
+    # every live process's cumulative CPU-time counter. Keeping both reads in one
+    # consistent pass is what keeps the elapsed and CPU-time windows aligned.
+    now = time.time()
+    snapshot = {}
+    for pid, proc in current.items():
+        try:
+            snapshot[pid] = _cpu_seconds(proc)
+        except psutil.NoSuchProcess:
+            pass
+
+    prev = state.get("prev")
+    last_wall = state.get("wall")
+    state["prev"] = snapshot
+    state["wall"] = now
+
+    # First call establishes the baseline; a delta needs two snapshots.
+    if prev is None or last_wall is None:
+        return 0.0
+
+    elapsed = max(now - last_wall, 1e-6)
+    ncpu = psutil.cpu_count(logical=True) or 1
+
+    total_delta = 0.0
+    for pid, cur in snapshot.items():
+        if pid not in prev:
+            continue  # newly seen this tick; no prior counter to difference
+        delta = cur - prev[pid]
+        if delta <= 0:
+            continue
+        total_delta += delta
+        if contributors is not None:
+            name = cmd = ""
+            try:
+                proc = current[pid]
+                name = proc.name()
+                cmd = " ".join(proc.cmdline())
+            except Exception:
+                pass
+            contributors.append(
+                (pid, round(delta / elapsed / ncpu * 100, 1), name, cmd)
+            )
+
+    return round(total_delta / elapsed / ncpu * 100, 2)
+
+
+def sample_system_cpu() -> float:
+    """Return whole-host CPU%% since the previous call (0..100, already
+    normalized so 100 = every logical core fully busy). Prime once before the
+    loop so the first real reading covers a real interval rather than 0. Unlike
+    ``sample_cpu`` this counts EVERYTHING on the box — OS, other containers,
+    vLLM, and the poller itself — so it is a total-load backdrop, not per-tool
+    attributable."""
+    if psutil is None:
+        return 0.0
+    try:
+        return psutil.cpu_percent(interval=None)
+    except Exception:
+        return 0.0
+
+
+def _open_append(path: str, header):
+    """Open ``path`` in append mode (so ``hermes -r`` accumulates rather than
+    overwriting) and write ``header`` only when the file is new/empty."""
+    is_new = not os.path.exists(path) or os.path.getsize(path) == 0
+    fh = open(path, "a", newline="")
+    writer = csv.writer(fh)
+    if is_new:
+        writer.writerow(header)
+        fh.flush()
+    return fh, writer
+
+
+def main():
+    if len(sys.argv) < 5:
+        sys.stderr.write(
+            "usage: metrics_poller.py <out_dir> <exporter_url> <interval> <hermes_pid>\n"
+        )
+        return 1
+
+    out_dir = sys.argv[1]
+    url = sys.argv[2]
+    try:
+        interval = float(sys.argv[3])
+    except ValueError:
+        interval = 0.1
+    try:
+        hermes_pid = int(sys.argv[4])
+    except ValueError:
+        hermes_pid = None
+
+    # Each signal is sampled only when its flag is set (inherited from hermes).
+    want_cpu = _flag("HERMES_CPU_TRACE")
+    want_cpu_system = _flag("HERMES_CPU_SYSTEM_WIDE")
+    want_gpu = _flag("HERMES_GPU_SYSTEM_WIDE")
+
+    signal.signal(signal.SIGTERM, _stop)
+    signal.signal(signal.SIGINT, _stop)
+
+    root = None
+    if psutil is not None and hermes_pid is not None:
+        try:
+            root = psutil.Process(hermes_pid)
+        except Exception:
+            root = None
+    cpu_state = {}
+
+    # Open one writer per enabled signal. If nothing is enabled there is nothing
+    # to do — exit cleanly (tool_profiler shouldn't have launched us, but guard).
+    handles = []
+    cpu_writer = cpu_system_writer = gpu_writer = None
+    if want_cpu:
+        fh, cpu_writer = _open_append(
+            os.path.join(out_dir, "cpu_hermes_trace.csv"),
+            ["timestamp", "start_time_unix_nano", "cpu_pct"],
+        )
+        handles.append(fh)
+    if want_cpu_system:
+        fh, cpu_system_writer = _open_append(
+            os.path.join(out_dir, "cpu_system_wide.csv"),
+            ["timestamp", "start_time_unix_nano", "cpu_pct"],
+        )
+        handles.append(fh)
+    if want_gpu:
+        fh, gpu_writer = _open_append(
+            os.path.join(out_dir, "gpu_system_wide.csv"),
+            ["timestamp", "start_time_unix_nano", "gfx_busy_pct", "power_w", "vram_mb"],
+        )
+        handles.append(fh)
+
+    if not handles:
+        return 0
+
+    # Optional per-PID attribution of non-zero hermes-tree CPU readings. Set
+    # HERMES_CPU_DEBUG=1 to record which process/command accounts for each reading.
+    debug_cpu = want_cpu and os.environ.get("HERMES_CPU_DEBUG", "").lower() in ("1", "true", "yes")
+    debug_file = None
+    debug_writer = None
+    if debug_cpu:
+        debug_path = os.path.join(out_dir, "cpu_debug.csv")
+        debug_file, debug_writer = _open_append(
+            debug_path, ["timestamp", "pid", "cpu_pct", "name", "cmdline"]
+        )
+
+    # Prime the CPU delta baselines before the first real sample.
+    if want_cpu:
+        sample_cpu(cpu_state, root)
+    if want_cpu_system:
+        sample_system_cpu()
+
+    try:
+        while _RUNNING:
+            wall = time.time()
+            ts = datetime.fromtimestamp(wall).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
+            # Absolute epoch nanoseconds — same reference MLflow uses for span
+            # start_time_unix_nano, so the timelines and the trace waterfall can
+            # be plotted on one shared wall-clock axis (no UTC-offset ambiguity).
+            ts_ns = int(wall * 1_000_000_000)
+
+            if want_cpu:
+                contributors = [] if debug_cpu else None
+                cpu = sample_cpu(cpu_state, root, contributors)
+                cpu_writer.writerow([ts, ts_ns, cpu])
+                if debug_writer is not None and contributors:
+                    for pid, c, name, cmd in contributors:
+                        debug_writer.writerow([ts, pid, c, name, cmd])
+                    debug_file.flush()
+
+            if want_cpu_system:
+                cpu_system_writer.writerow([ts, ts_ns, sample_system_cpu()])
+
+            if want_gpu:
+                gfx, power, vram = scrape_gpu(url)
+                gpu_writer.writerow([ts, ts_ns, gfx, power, vram])
+
+            for fh in handles:
+                fh.flush()
+
+            time.sleep(interval)
+    finally:
+        for fh in handles:
+            try:
+                fh.close()
+            except Exception:
+                pass
+        if debug_file is not None:
+            debug_file.close()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/mlflow_hooks.py b/mlflow_hooks.py
new file mode 100644
index 0000000..c5ef3d4
--- /dev/null
+++ b/mlflow_hooks.py
@@ -0,0 +1,463 @@
+"""MLflow hardware metrics integration for Hermes.
+
+Extends hermes-otel hooks to start/stop MLflow runs automatically,
+enabling hardware metric collection alongside OpenTelemetry traces.
+Also captures vLLM cache metrics per session.
+"""
+
+import csv
+import logging
+import os
+from datetime import datetime
+from typing import Dict, Optional
+
+from . import profiling_env as _env
+from .debug_utils import debug_log, logger
+
+
+try:
+    import mlflow
+    MLFLOW_AVAILABLE = True
+except ImportError:
+    MLFLOW_AVAILABLE = False
+
+try:
+    import requests
+    REQUESTS_AVAILABLE = True
+except ImportError:
+    REQUESTS_AVAILABLE = False
+
+
+# MLflow applies these settings when a run starts, so defining them here — after
+# the imports — still takes effect before the first run. Disabling system-metrics
+# logging matters: it stops MLflow from launching its own background sampler
+# thread, keeping all hardware sampling in the out-of-process poller. Log-level
+# suppression is additionally enforced at call time by _mute_mlflow_logging().
+os.environ["MLFLOW_ENABLE_SYSTEM_METRICS_LOGGING"] = "false"
+os.environ["MLFLOW_SYSTEM_METRICS_SAMPLING_INTERVAL"] = "1"
+os.environ["MLFLOW_TRACKING_URI"] = os.environ.get("MLFLOW_TRACKING_URI", "http://127.0.0.1:5000")
+os.environ["MLFLOW_LOGGING_LEVEL"] = os.environ.get("MLFLOW_LOGGING_LEVEL", "ERROR")
+
+
+def _mute_mlflow_logging():
+    """Silence MLflow's own INFO logs (e.g. "View run"/"View experiment" URLs).
+    MLflow lazily (re)configures its loggers to INFO on API calls, so this must be
+    invoked right before each start_run/end_run, not once at import time.
+    """
+    for name in ("mlflow", "mlflow.tracking.fluent"):
+        logging.getLogger(name).setLevel(logging.WARNING)
+
+# Track active MLflow run per session
+_active_runs = {}
+# Track vLLM cache baseline metrics per session
+_cache_baselines = {}
+# Track turn number per session for step-based metrics
+_turn_counters = {}
+# Per session: True when the next on_pre_llm_call should capture a fresh baseline
+# (i.e. a new user turn has begun). Prevents intra-turn LLM calls from re-snapping
+# the baseline and producing ~0 deltas.
+_awaiting_baseline = {}
+# session_id -> highest turn number already logged to MLflow. on_session_end can
+# fire more than once for the same turn (e.g. a normal completion followed by an
+# interrupt/exit). Without this guard the second call logs the same step again,
+# plotting two points at one step. We log a turn at most once.
+_last_logged_turn = {}
+# Ensure the process-exit handler that closes runs is registered exactly once
+_atexit_registered = False
+# Set once MLflow has failed to start a run (e.g. an unreachable or misconfigured
+# tracking server). Further MLflow work is then skipped for the rest of the
+# process so the failure is reported once instead of on every turn.
+_mlflow_disabled = False
+
+
+def has_active_run(session_id: str) -> bool:
+    """Check if an MLflow run is already active for this session."""
+    return session_id in _active_runs
+
+
+def capture_turn_baseline(session_id: str) -> None:
+    """Snapshot vLLM cache counters at the START of a user turn.
+
+    Captured only once per turn (first LLM call after the previous turn ended),
+    guarded by the _awaiting_baseline flag, so intra-turn LLM calls don't re-snap
+    it and produce a ~0 delta.
+    """
+    if not MLFLOW_AVAILABLE or not session_id or not _env.vllm_cache_metrics():
+        return
+    if session_id not in _active_runs:
+        return
+    if not _awaiting_baseline.get(session_id, False):
+        return  # already captured for this turn; ignore intra-turn LLM calls
+    _cache_baselines[session_id] = scrape_vllm_cache_metrics(_env.vllm_port())
+    _awaiting_baseline[session_id] = False
+
+
+def scrape_vllm_cache_metrics(port: str = "8001") -> Dict[str, float]:
+    """Scrapes vLLM prometheus endpoint to extract raw cache counter values."""
+    metrics = {"prefix_hits": 0.0, "prefix_queries": 0.0, "mm_hits": 0.0, "mm_queries": 0.0}
+
+    if not REQUESTS_AVAILABLE:
+        return metrics
+
+    try:
+        res = requests.get(f"http://localhost:{port}/metrics", timeout=2)
+        if res.status_code == 200:
+            for line in res.text.splitlines():
+                if line.startswith("vllm:prefix_cache_hits_total"):
+                    metrics["prefix_hits"] = float(line.split()[-1])
+                elif line.startswith("vllm:prefix_cache_queries_total"):
+                    metrics["prefix_queries"] = float(line.split()[-1])
+                elif line.startswith("vllm:mm_cache_hits_total"):
+                    metrics["mm_hits"] = float(line.split()[-1])
+                elif line.startswith("vllm:mm_cache_queries_total"):
+                    metrics["mm_queries"] = float(line.split()[-1])
+    except Exception:
+        # Silently fail if vLLM server is not available
+        pass
+
+    return metrics
+
+
+def _find_existing_run(session_id: str) -> Optional[str]:
+    """Find existing MLflow run for this session by querying MLflow."""
+    try:
+        experiment = mlflow.get_experiment_by_name(
+            os.environ.get("MLFLOW_EXPERIMENT_NAME", "Default")
+        )
+        if not experiment:
+            return None
+
+        # Search for runs with matching session_id parameter
+        client = mlflow.tracking.MlflowClient()
+        runs = client.search_runs(
+            experiment_ids=[experiment.experiment_id],
+            filter_string=f"params.session_id = '{session_id}'",
+            max_results=1,
+            order_by=["start_time DESC"]
+        )
+
+        if runs:
+            return runs[0].info.run_id
+        return None
+    except Exception:
+        return None
+
+
+def start_mlflow_run(session_id: str, model: str, platform: str, **kwargs):
+    """Start MLflow run for hardware metrics collection."""
+    global _mlflow_disabled
+    if not MLFLOW_AVAILABLE:
+        return
+    # MLflow is only used for the vLLM cache metrics. Skip it entirely for
+    # CSV-only traces (CPU/GPU/tool) so a session that is not collecting vLLM
+    # metrics never contacts a tracking server.
+    if not _env.mlflow_enabled():
+        return
+    # A prior start already failed (e.g. unreachable tracking server); stay
+    # disabled so the failure is not re-reported on every turn.
+    if _mlflow_disabled:
+        return
+
+    _mute_mlflow_logging()
+
+    try:
+        # Set tracking URI and experiment
+        mlflow.set_tracking_uri(os.environ.get("MLFLOW_TRACKING_URI", "http://127.0.0.1:5000"))
+        mlflow.set_experiment(os.environ.get("MLFLOW_EXPERIMENT_NAME", "Default"))
+
+        # Check if this session already has an MLflow run (for --resume)
+        existing_run_id = _find_existing_run(session_id)
+
+        if existing_run_id:
+            # Continue existing run
+            run = mlflow.start_run(run_id=existing_run_id)
+            _active_runs[session_id] = run.info.run_id
+
+            # On resume, sync with tool_profiler's .turn_count (the single source of truth)
+            # MLflow step numbers should match the CSV turn column exactly, even if some
+            # turns were interrupted and never logged metrics.
+            try:
+                from . import tool_profiler
+                _turn_counters[session_id] = tool_profiler.current_turn(session_id)
+            except Exception:
+                # Fallback if tool_profiler unavailable
+                _turn_counters[session_id] = 1
+
+            # Refresh baseline cache metrics for this resumed session
+            if _env.vllm_cache_metrics():
+                _cache_baselines[session_id] = scrape_vllm_cache_metrics(_env.vllm_port())
+                _awaiting_baseline[session_id] = True
+            _register_atexit_once()
+            return
+
+        # No existing run - create new one
+        # Start MLflow run with customizable name
+        # Users can set MLFLOW_RUN_NAME to customize the run name
+        # Supports placeholders: {platform}, {model}, {session_id}, {clean_model}
+
+        custom_name = os.environ.get("MLFLOW_RUN_NAME", "")
+
+        if custom_name:
+            # User provided custom format with placeholders
+            clean_model = model.replace("/", "_").replace(":", "_")
+            run_name = custom_name.format(
+                platform=platform,
+                model=model,
+                clean_model=clean_model,
+                session_id=session_id[:8]
+            )
+        else:
+            # Default format: Hermes_CleanModelName_SessionID
+            clean_model = model.replace("/", "_").replace(":", "_")
+            run_name = f"Hermes_{clean_model}_{session_id[:8]}"
+
+        run = mlflow.start_run(run_name=run_name)
+
+        # Store the run ID for this session
+        _active_runs[session_id] = run.info.run_id
+
+        # Log session metadata
+        mlflow.log_param("session_id", session_id)
+        mlflow.log_param("model", model)
+        mlflow.log_param("platform", platform)
+
+        # Capture baseline vLLM cache metrics (only when vLLM tracing is on).
+        if _env.vllm_cache_metrics():
+            _cache_baselines[session_id] = scrape_vllm_cache_metrics(_env.vllm_port())
+            # First real user turn should re-snap the baseline right before it runs.
+            _awaiting_baseline[session_id] = True
+
+        # Initialize turn counter for this session
+        _turn_counters[session_id] = 1
+
+        # The MLflow run now lives for the whole process (see end_mlflow_run);
+        # close it exactly once at process exit instead of per turn.
+        _register_atexit_once()
+
+    except Exception as e:
+        import traceback
+
+        _mlflow_disabled = True
+        logger.warning(
+            "[hermes-otel] MLflow run could not be started (%s); disabling MLflow "
+            "metrics for the rest of this process. Check MLFLOW_TRACKING_URI.",
+            e,
+        )
+        debug_log(f"MLflow start_run traceback:\n{traceback.format_exc()}")
+
+
+def _register_atexit_once():
+    """Register the process-exit handler that closes MLflow runs exactly once."""
+    global _atexit_registered
+    if _atexit_registered:
+        return
+    import atexit
+    atexit.register(_end_all_runs_at_exit)
+    _atexit_registered = True
+
+
+def _upload_profiling_artifacts(run_id: str, session_id: str) -> None:
+    """Upload the CPU/GPU/tool CSVs to the run, overwriting prior versions.
+
+    Called every turn so a crash or kill -9 (which skips atexit) never loses the
+    artifacts. MLflow keeps the latest uploaded copy per filename.
+    """
+    if not MLFLOW_AVAILABLE or not run_id:
+        return
+    try:
+        client = mlflow.tracking.MlflowClient()
+        out_dir = os.path.join(
+            os.environ.get("HERMES_PROFILING_OUTPUT_DIR", "./outputs"), session_id
+        )
+        for fname in (
+            "cpu_hermes_trace.csv",
+            "cpu_system_wide.csv",
+            "gpu_system_wide.csv",
+            "tool_execution.csv",
+            "vllm_cache_metrics.csv",
+        ):
+            fpath = os.path.join(out_dir, fname)
+            if os.path.exists(fpath):
+                try:
+                    client.log_artifact(run_id, fpath, artifact_path="profiling")
+                except Exception:
+                    pass
+    except Exception:
+        pass
+
+
+def _end_all_runs_at_exit():
+    """Close every still-open MLflow run at process exit.
+
+    The run is kept open across turns so a flaky _find_existing_run() can never
+    blank out a turn's metrics. Artifacts are also re-uploaded each turn
+    (_upload_profiling_artifacts); here we do a final upload and end the run.
+    Honors MLFLOW_KEEP_RUN_ACTIVE.
+    """
+    if not MLFLOW_AVAILABLE:
+        return
+    keep_run_active = os.environ.get("MLFLOW_KEEP_RUN_ACTIVE", "false").lower() == "true"
+    client = mlflow.tracking.MlflowClient()
+    for session_id, run_id in list(_active_runs.items()):
+        try:
+            # Final artifact upload (also uploaded each turn for crash safety).
+            _upload_profiling_artifacts(run_id, session_id)
+            if not keep_run_active:
+                # Terminate the explicit run (client equivalent of end_run).
+                client.set_terminated(run_id, status="FINISHED")
+        except Exception:
+            pass
+        finally:
+            _active_runs.pop(session_id, None)
+            _cache_baselines.pop(session_id, None)
+            _turn_counters.pop(session_id, None)
+            _awaiting_baseline.pop(session_id, None)
+            _last_logged_turn.pop(session_id, None)
+
+
+_VLLM_CACHE_HEADER = [
+    "turn", "timestamp", "start_time_unix_nano",
+    "text_hits", "text_queries", "text_hit_rate_pct",
+    "mm_hits", "mm_queries", "mm_hit_rate_pct",
+]
+
+
+def _append_vllm_cache_csv(
+    session_id, turn, text_hits, text_queries, text_hit_rate,
+    mm_hits, mm_queries, mm_hit_rate,
+):
+    """Append one per-turn row to <out_dir>/vllm_cache_metrics.csv (created with
+    a header on first write). This is the CSV twin of the MLflow cache graphs so
+    the same numbers are available offline / uploaded as an artifact."""
+    try:
+        out_dir = os.path.join(
+            os.environ.get("HERMES_PROFILING_OUTPUT_DIR", "./outputs"), session_id
+        )
+        os.makedirs(out_dir, exist_ok=True)
+        path = os.path.join(out_dir, "vllm_cache_metrics.csv")
+        is_new = not os.path.exists(path) or os.path.getsize(path) == 0
+        wall = datetime.now()
+        ts = wall.strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
+        ts_ns = int(wall.timestamp() * 1_000_000_000)
+        with open(path, "a", newline="") as f:
+            w = csv.writer(f)
+            if is_new:
+                w.writerow(_VLLM_CACHE_HEADER)
+            w.writerow([
+                turn, ts, ts_ns,
+                int(text_hits), int(text_queries), round(text_hit_rate, 2),
+                int(mm_hits), int(mm_queries), round(mm_hit_rate, 2),
+            ])
+    except Exception as e:
+        debug_log(f"could not append vllm_cache_metrics.csv: {e}")
+
+
+def end_mlflow_run(
+    session_id: str, completed: bool, interrupted: bool, model: str, platform: str, **kwargs
+):
+    """End MLflow run when session completes."""
+
+    if not MLFLOW_AVAILABLE:
+        return
+
+    _mute_mlflow_logging()
+
+    # The run is kept open for the whole process (closed at exit via atexit), so
+    # we only READ it here — never pop it. Popping per turn was the root cause of
+    # "No active run found": a turn whose start failed to re-discover the run via
+    # _find_existing_run() would, and every turn after it, log nothing.
+    run_id = _active_runs.get(session_id)
+    if not run_id:
+        return
+
+    try:
+        # Capture final vLLM cache metrics and compute delta. baseline is only
+        # set when HERMES_VLLM_CACHE_METRICS is on, so this whole block is a
+        # no-op otherwise.
+        baseline = _cache_baselines.get(session_id, None)
+        if baseline:
+            after_metrics = scrape_vllm_cache_metrics(_env.vllm_port())
+
+            # Calculate deltas for this turn
+            req_text_queries = after_metrics["prefix_queries"] - baseline["prefix_queries"]
+            req_text_hits = after_metrics["prefix_hits"] - baseline["prefix_hits"]
+            req_mm_queries = after_metrics["mm_queries"] - baseline["mm_queries"]
+            req_mm_hits = after_metrics["mm_hits"] - baseline["mm_hits"]
+
+            # Compute hit rate
+            text_hit_rate = (req_text_hits / req_text_queries * 100) if req_text_queries > 0 else 0.0
+            mm_hit_rate = (req_mm_hits / req_mm_queries * 100) if req_mm_queries > 0 else 0.0
+
+            # Get current turn number from tool_profiler's shared counter so the
+            # MLflow step matches the CSV's turn exactly (single source of truth).
+            # Fall back to the local counter if tool_profiler is unavailable.
+            try:
+                from . import tool_profiler
+                turn_number = tool_profiler.current_turn(session_id) or _turn_counters.get(session_id, 1)
+            except Exception:
+                turn_number = _turn_counters.get(session_id, 1)
+
+            # Idempotency guard: on_session_end can fire more than once for the
+            # same turn (e.g. a normal completion followed by an interrupt/exit).
+            # log_metric APPENDS to a step's history, so logging the same step
+            # twice plots two points at one step. Log each turn's metrics at most
+            # once; status tags below still update on the repeat call.
+            already_logged = _last_logged_turn.get(session_id) == turn_number
+            if not already_logged:
+                _last_logged_turn[session_id] = turn_number
+
+                # Log to the EXPLICIT run_id via MlflowClient, not the fluent
+                # mlflow.log_metric(). The fluent API writes to whatever run is
+                # active in MLflow's internal context, which can drift from the
+                # run we kept open across turns.
+                client = mlflow.tracking.MlflowClient()
+                # Order determines display order in MLflow UI
+                client.log_metric(run_id, "vllm_text_cache_hit_rate_pct", text_hit_rate, step=turn_number)
+                client.log_metric(run_id, "vllm_text_cache_hits", req_text_hits, step=turn_number)
+                client.log_metric(run_id, "vllm_text_cache_queries", req_text_queries, step=turn_number)
+                client.log_metric(run_id, "vllm_mm_cache_hit_rate_pct", mm_hit_rate, step=turn_number)
+                client.log_metric(run_id, "vllm_mm_cache_hits", req_mm_hits, step=turn_number)
+                client.log_metric(run_id, "vllm_mm_cache_queries", req_mm_queries, step=turn_number)
+
+                # Update tags with cumulative totals (latest turn values)
+                if req_text_queries > 0 or req_mm_queries > 0:
+                    client.set_tag(run_id, "cache.text_hit_tokens", int(req_text_hits))
+                    client.set_tag(run_id, "cache.text_hit_rate", f"{text_hit_rate:.1f}%")
+                    client.set_tag(run_id, "cache.image_hit", "True" if req_mm_hits > 0 else "False")
+                    client.set_tag(run_id, "latest_turn", turn_number)
+
+                # Mirror this turn's cache metrics into vllm_cache_metrics.csv
+                # (same once-per-turn guard as the MLflow graphs, so no dupes).
+                _append_vllm_cache_csv(
+                    session_id, turn_number,
+                    req_text_hits, req_text_queries, text_hit_rate,
+                    req_mm_hits, req_mm_queries, mm_hit_rate,
+                )
+
+            # Baseline is re-captured at the next turn's start (capture_turn_baseline),
+            # not reset here, so each turn's delta is self-contained.
+            _turn_counters[session_id] = turn_number
+
+            # Arm baseline capture for the NEXT user turn. The first
+            # on_pre_llm_call after this point re-snaps the baseline.
+            _awaiting_baseline[session_id] = True
+
+        # Update latest session status as tags (not params, since they can change
+        # every turn). The run itself stays open until process exit. Use the
+        # explicit client so this always targets the run we kept open.
+        status = "FINISHED" if completed else "FAILED" if interrupted else "KILLED"
+        client = mlflow.tracking.MlflowClient()
+        client.set_tag(run_id, "status", status)
+        client.set_tag(run_id, "completed", str(completed))
+        client.set_tag(run_id, "interrupted", str(interrupted))
+
+        # Re-upload profiling CSVs every turn (overwriting) so a crash or kill -9
+        # — which skips the atexit handler — never loses them. The run itself is
+        # ended only once, at process exit (_end_all_runs_at_exit); ending it here
+        # would force the fragile per-turn re-discovery this design removes.
+        _upload_profiling_artifacts(run_id, session_id)
+
+    except Exception as e:
+        import traceback
+        logger.warning("[hermes-otel] MLflow: failed to end run: %s", e)
+        debug_log(f"MLflow end_run traceback:\n{traceback.format_exc()}")
