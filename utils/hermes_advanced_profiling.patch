index 0000000..c2edcfa
--- /dev/null
+++ b/hermes_otel/csv_dump.py
@@ -0,0 +1,353 @@
+"""Internal-only: mirror the host-metrics sampler's readings to CSV + PNGs.
+
+Not part of upstream hermes-otel. The mainline ``host_metrics`` sampler
+(``host_metrics.py``) keeps only a bounded in-memory ring (~10 minutes at the
+default interval) — enough to slice a per-tool window, but the full-session
+timeline is gone once the ring wraps. This module re-adds full-session CSV
+capture (unbounded, one continuous run per Hermes process) plus the original
+``plot_profiling.py`` chart renderer, without touching or duplicating any of
+the vendor-probing/sampling logic in ``host_metrics.py`` / ``gpu_probe.py``.
+
+Design: ``HermesOTelPlugin._mirror_host_sample`` is the sole ``on_sample``
+callback the sampler is constructed with (see ``tracer.py``'s
+``_ensure_host_sampler``). That callback is captured by reference at sampler
+construction time (inside ``tracer.init()``), so this module's ``install()``
+must patch the *class* attribute before ``tracer.init()`` runs — patching the
+already-created tracer *instance* afterward would have no effect, since the
+sampler would still hold a reference to the original unwrapped method.
+Hence ``install()`` is called from ``__init__.py`` before ``get_tracer()``.
+
+Opt-in via HERMES_CSV_DUMP=true (writes CSVs); HERMES_PLOT_PROFILING=true
+additionally renders the 4 PNGs at process exit. Off has zero overhead beyond
+one wrapped method call. Output: <HERMES_PROFILING_OUTPUT_DIR or ./outputs>/
+<run-timestamp>/{cpu_hermes_trace,cpu_system_wide,gpu_system_wide}.csv, then
+plots/ under the same directory.
+"""
+
+from __future__ import annotations
+
+import atexit
+import csv
+import functools
+import json
+import os
+import subprocess
+import sys
+import threading
+import time
+from datetime import datetime
+from typing import Any, Dict, Optional, Tuple
+
+from .debug_utils import debug_log
+from .helpers import truncate_string
+
+_TRUE = ("1", "true", "yes", "on")
+
+
+def _flag(name: str) -> bool:
+    return os.environ.get(name, "").strip().lower() in _TRUE
+
+
+_out_dir: Optional[str] = None
+_run_start_wall: Optional[float] = None
+_writers: Dict[str, Tuple[Any, Any]] = {}
+_installed = False
+
+# Per-tool bookkeeping for tool_execution.csv. Keyed by "{tool_name}:{task_id}",
+# same convention the original tool_profiler.py used.
+_tool_starts: Dict[str, float] = {}
+# Stashes the calling on_post_tool_call's (tool_name, args, result, task_id,
+# kwargs) so the nested _tool_host_utilization_attributes call — which only
+# receives (tracer, started_at, ended_at) — can be correlated back to it.
+# Thread-local since concurrent tool calls on different sessions may run on
+# different threads; each thread only ever has one tool call in flight at a
+# time within its own on_post_tool_call frame.
+_tool_ctx = threading.local()
+
+_TOOL_HEADER = [
+    "turn",
+    "tool_name",
+    "input",
+    "output",
+    "timestamp",
+    "start_time_unix_nano",
+    "elapsed_s",
+    "duration_s",
+    "cpu_avg_pct",
+    "cpu_peak_pct",
+    "gpu_avg_pct",
+    "gpu_peak_pct",
+]
+
+
+def _ensure_output_dir() -> str:
+    global _out_dir, _run_start_wall
+    if _out_dir is None:
+        base = os.environ.get("HERMES_PROFILING_OUTPUT_DIR", "./outputs")
+        run_id = datetime.now().strftime("%Y%m%d_%H%M%S")
+        _out_dir = os.path.join(base, run_id)
+        os.makedirs(_out_dir, exist_ok=True)
+        _run_start_wall = time.time()
+    return _out_dir
+
+
+def _open_append(path: str, header):
+    is_new = not os.path.exists(path) or os.path.getsize(path) == 0
+    fh = open(path, "a", newline="")
+    writer = csv.writer(fh)
+    if is_new:
+        writer.writerow(header)
+        fh.flush()
+    return fh, writer
+
+
+def _get_writers() -> Dict[str, Tuple[Any, Any]]:
+    # Per-key guards, not "is the dict empty" — _writers is shared with
+    # _get_tool_writer()'s "tool" entry, which may already have been created
+    # by an earlier tool call before the first host-metrics sample arrives.
+    out_dir = _ensure_output_dir()
+    if "hermes" not in _writers:
+        _writers["hermes"] = _open_append(
+            os.path.join(out_dir, "cpu_hermes_trace.csv"),
+            ["timestamp", "start_time_unix_nano", "cpu_pct"],
+        )
+    if "system" not in _writers:
+        _writers["system"] = _open_append(
+            os.path.join(out_dir, "cpu_system_wide.csv"),
+            ["timestamp", "start_time_unix_nano", "cpu_pct"],
+        )
+    if "gpu" not in _writers:
+        _writers["gpu"] = _open_append(
+            os.path.join(out_dir, "gpu_system_wide.csv"),
+            ["timestamp", "start_time_unix_nano", "gfx_busy_pct", "power_w", "vram_mb"],
+        )
+    return _writers
+
+
+def _on_sample(sample: Any) -> None:
+    """Append one row per signal for this Sample. Percentages are written on
+    the original 0..100 scale (matching plot_profiling.py's y-axes), even
+    though host_metrics.py's Sample carries 0..1 fractions internally."""
+    if not _flag("HERMES_CSV_DUMP"):
+        return
+
+    writers = _get_writers()
+    ts = datetime.fromtimestamp(sample.wall_ns / 1e9).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
+    ts_ns = sample.wall_ns
+
+    fh, writer = writers["hermes"]
+    writer.writerow([ts, ts_ns, round(sample.process_cpu_total * 100, 2)])
+    fh.flush()
+
+    fh, writer = writers["system"]
+    writer.writerow([ts, ts_ns, round(sample.system_cpu_total * 100, 2)])
+    fh.flush()
+
+    gpus = sample.gpus
+    if gpus:
+        util = sample.gpu_utilization
+        power = sum(g.power_w for g in gpus if g.power_w is not None)
+        vram_mb = sum(g.memory_bytes for g in gpus if g.memory_bytes is not None) / (1024 * 1024)
+        fh, writer = writers["gpu"]
+        writer.writerow(
+            [ts, ts_ns, round((util or 0.0) * 100, 2), round(power, 2), round(vram_mb, 2)]
+        )
+        fh.flush()
+
+
+def _get_tool_writer() -> Tuple[Any, Any]:
+    if "tool" not in _writers:
+        out_dir = _ensure_output_dir()
+        _writers["tool"] = _open_append(os.path.join(out_dir, "tool_execution.csv"), _TOOL_HEADER)
+    return _writers["tool"]
+
+
+def _wrap_pre_tool_call(original):
+    """Capture the tool's wall-clock start (time.time()), keyed the same way
+    on_post_tool_call keys its own state. _tool_host_utilization_attributes
+    only sees time.perf_counter() values (monotonic, no epoch), so this is the
+    only place a real timestamp for the CSV row is available."""
+
+    @functools.wraps(original)
+    def wrapper(tool_name, args, task_id, **kwargs):
+        if _flag("HERMES_CSV_DUMP"):
+            _tool_starts[f"{tool_name}:{task_id}"] = time.time()
+        return original(tool_name, args, task_id, **kwargs)
+
+    return wrapper
+
+
+def _wrap_post_tool_call(original):
+    """Stash this call's (tool_name, args, result, task_id, kwargs) so the
+    _tool_host_utilization_attributes call nested inside ``original`` — which
+    only receives (tracer, started_at, ended_at) — can find it."""
+
+    @functools.wraps(original)
+    def wrapper(tool_name, args, result, task_id, **kwargs):
+        _tool_ctx.value = (tool_name, args, result, task_id, kwargs)
+        try:
+            return original(tool_name, args, result, task_id, **kwargs)
+        finally:
+            _tool_ctx.value = None
+
+    return wrapper
+
+
+def _wrap_tool_utilization_attrs(original):
+    """After the mainline per-tool avg/peak attributes are computed, also
+    write the row to tool_execution.csv, reusing those already-computed
+    values instead of re-deriving them."""
+
+    @functools.wraps(original)
+    def wrapper(tracer, started_at, ended_at):
+        attrs = original(tracer, started_at, ended_at)
+        if _flag("HERMES_CSV_DUMP"):
+            try:
+                _write_tool_row(tracer, started_at, ended_at, attrs)
+            except Exception as e:
+                debug_log(f"csv_dump: failed to write tool row: {e}")
+        return attrs
+
+    return wrapper
+
+
+def _write_tool_row(tracer: Any, started_at: float, ended_at: float, attrs: Dict[str, Any]) -> None:
+    ctx = getattr(_tool_ctx, "value", None)
+    if ctx is None:
+        return
+    tool_name, args, result, task_id, kwargs = ctx
+
+    wall_start = _tool_starts.pop(f"{tool_name}:{task_id}", None)
+    if wall_start is None:
+        return
+
+    session_id = kwargs.get("session_id")
+    turn = tracer.sessions.turn_number(session_id) if session_id else 0
+
+    # Respect the same privacy toggle the OTel spans already honor (see
+    # hooks.py's _preview()) — capture_previews: false must suppress tool
+    # content everywhere, not just on the span's input.value/output.value.
+    if tracer.config.capture_previews:
+        try:
+            tool_input = json.dumps(args) if args else ""
+        except Exception:
+            tool_input = str(args) if args else ""
+        tool_input = truncate_string(tool_input, 1200)
+        tool_output = truncate_string(
+            result if isinstance(result, str) else str(result or ""), 1200
+        )
+    else:
+        tool_input = ""
+        tool_output = ""
+
+    ts = datetime.fromtimestamp(wall_start).strftime("%Y-%m-%d %H:%M:%S.%f")[:-3]
+    ts_ns = int(wall_start * 1_000_000_000)
+    run_start = _run_start_wall if _run_start_wall is not None else wall_start
+    elapsed_s = round(wall_start - run_start, 3)
+    duration_s = round(ended_at - started_at, 3)
+
+    cpu_avg = attrs.get("hermes.tool.cpu.utilization.avg")
+    cpu_peak = attrs.get("hermes.tool.cpu.utilization.peak")
+    gpu_avg = attrs.get("hermes.tool.gpu.utilization.avg")
+    gpu_peak = attrs.get("hermes.tool.gpu.utilization.peak")
+
+    fh, writer = _get_tool_writer()
+    writer.writerow(
+        [
+            turn,
+            tool_name,
+            tool_input,
+            tool_output,
+            ts,
+            ts_ns,
+            elapsed_s,
+            duration_s,
+            round(cpu_avg * 100, 2) if cpu_avg is not None else 0.0,
+            round(cpu_peak * 100, 2) if cpu_peak is not None else 0.0,
+            round(gpu_avg * 100, 2) if gpu_avg is not None else "",
+            round(gpu_peak * 100, 2) if gpu_peak is not None else "",
+        ]
+    )
+    fh.flush()
+
+
+_plots_rendered = False
+
+
+def render_plots() -> None:
+    """Render the PNG charts from whatever CSVs exist in the current run's
+    output directory. Idempotent (renders at most once per process) and safe
+    to call from more than one place — e.g. both this module's own atexit
+    handler and, if the vLLM/MLflow addon patch is applied on top, its
+    artifact-upload path — regardless of atexit registration order between
+    the two, since atexit runs LIFO and the addon's upload hook would
+    otherwise fire before this module's own plot-rendering hook does."""
+    global _plots_rendered
+    if _plots_rendered or _out_dir is None or not _flag("HERMES_PLOT_PROFILING"):
+        return
+    _plots_rendered = True
+    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "plot_profiling.py")
+    try:
+        subprocess.run([sys.executable, script, _out_dir], timeout=120)
+    except Exception as e:
+        debug_log(f"csv_dump: plot rendering failed: {e}")
+
+
+def _finalize() -> None:
+    for fh, _writer in _writers.values():
+        try:
+            fh.close()
+        except Exception:
+            pass
+    render_plots()
+
+
+def _wrap_by_name(module: Any, name: str, wrapper_factory) -> None:
+    original = getattr(module, name, None)
+    if not callable(original):
+        debug_log(f"csv_dump: {name} not found on {module.__name__}; skipping wrap")
+        return
+    if getattr(original, "_hermes_csv_dump_wrapped", False):
+        return
+    wrapped = wrapper_factory(original)
+    wrapped._hermes_csv_dump_wrapped = True
+    setattr(module, name, wrapped)
+
+
+def install() -> None:
+    """Patch HermesOTelPlugin._mirror_host_sample at the class level so every
+    host-metrics sample also gets written to CSV, and wrap three hooks.py
+    functions by name so tool_execution.csv gets one row per tool call,
+    reusing the avg/peak values the mainline code already computes.
+
+    Must run before tracer.init() starts the sampler (see module docstring).
+    Idempotent; a no-op when HERMES_CSV_DUMP is never set to true, beyond a
+    few extra function calls per sample tick / tool call.
+    """
+    global _installed
+    if _installed:
+        return
+    _installed = True
+
+    from . import hooks
+    from .tracer import HermesOTelPlugin
+
+    original = HermesOTelPlugin._mirror_host_sample
+    if not getattr(original, "_hermes_csv_dump_wrapped", False):
+
+        @functools.wraps(original)
+        def wrapped(self, sample):
+            original(self, sample)
+            try:
+                _on_sample(sample)
+            except Exception as e:
+                debug_log(f"csv_dump: failed to write sample: {e}")
+
+        wrapped._hermes_csv_dump_wrapped = True
+        HermesOTelPlugin._mirror_host_sample = wrapped
+
+    _wrap_by_name(hooks, "on_pre_tool_call", _wrap_pre_tool_call)
+    _wrap_by_name(hooks, "on_post_tool_call", _wrap_post_tool_call)
+    _wrap_by_name(hooks, "_tool_host_utilization_attributes", _wrap_tool_utilization_attrs)
+
+    atexit.register(_finalize)
